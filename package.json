{
  "name": "graft",
  "productName": "Graft",
  "version": "0.6.13",
  "description": "Graft — a desktop coding agent.",
  "author": "Graft",
  "license": "MIT",
  "homepage": "https://github.com/itzdexy/GraftCode",
  "desktopName": "graft.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:docker": "node scripts/e2e-docker.mjs",
    "measure": "node scripts/measure-reference.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "catalog": "node scripts/update-catalog.mjs",
    "dist:win": "electron-vite build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never",
    "dist:mac": "electron-vite build && electron-builder --config electron-builder.config.cjs --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --config electron-builder.config.cjs --linux --publish never",
    "dist:linux:docker": "node scripts/dist-linux-docker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.130.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@vscode/ripgrep": "1.18.0",
    "better-sqlite3": "13.0.3",
    "diff": "9.0.0",
    "electron-updater": "6.8.9",
    "node-pty": "1.1.0",
    "picomatch": "4.0.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/picomatch": "4.0.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "docx": "9.8.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "globals": "17.12.0",
    "lucide-react": "1.49.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "pngjs": "7.0.0",
    "pptxgenjs": "4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "shiki": "4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "write-excel-file": "4.1.1",
    "zustand": "5.0.15"
  }
}
